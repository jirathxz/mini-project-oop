{
    "name": "cardvault/storefront",
    "description": "G2A-style digital key and gift card marketplace built with PHP OOP",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "CardVault Team"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "CardVault\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CardVault\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
